# Скопируйте в .env и заполните. Файл .env НЕ публикуйте и не отправляйте в чаты (там ключи).
PORT=3047
HOST=127.0.0.1
# Адрес сайта (для ссылки на список заказов в сообщении менеджеру)
SITE_URL=https://foto.example.ru
# nginx передаёт настоящий IP клиента — 1, если сайт за nginx
TRUST_PROXY=1
# ВКонтакте: ключ доступа сообщества с правом «Сообщения» и ID страницы менеджера (число)
VK_TOKEN=
VK_PEER_ID=
# Страница /admin — список заказов (пустой пароль = страница выключена)
ADMIN_USER=manager
ADMIN_PASS=
# База заказов (по умолчанию data/orders.sqlite)
# DB_PATH=/var/lib/fotochka/orders.sqlite
